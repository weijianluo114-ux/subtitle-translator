{
  "name": "kt-feedback-worker",
  "private": true,
  "version": "1.0.0",
  "description": "字幕整行翻译 · 用户反馈接收端（Cloudflare Worker + D1 + 飞书通知）",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute kt-feedback --remote --file=schema.sql",
    "db:init:local": "wrangler d1 execute kt-feedback --local --file=schema.sql",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "wrangler": "^4.42.0"
  }
}
